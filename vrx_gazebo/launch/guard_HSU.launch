<?xml version="1.0"?>
<launch>
  <env name="ROSCONSOLE_CONFIG_FILE" value="$(find vrx_gazebo)/config/custom_rosconsole.conf"/>
  
  <!-- Gazebo world to load -->
  <arg name="world" default="$(find vrx_gazebo)/worlds/motor_anchoring.world" />
  <!-- If true, run gazebo GUI -->
  <arg name="gui" default="true" />
  <!-- If true, run gazebo in verbose mode -->
  <arg name="verbose" default="false"/>
  <!-- Set various other gazebo arguments-->
  <arg name="extra_gazebo_args" default=""/>

  <!-- Parameters for both USVs -->
  <!-- Do we lock the vessel to the world? -->
  <arg name="wamv_locked" default="false" />
  <!-- Start paused? -->
  <arg name="paused" default="false"/>
  <!-- Acoustic pinger position(s) -->
  <arg name="pinger_params" default="$(find vrx_gazebo)/config/pinger.yaml"/>

  <!-- Allow user specified thruster configurations
  H = stern trusters on each hull
  T = H with a lateral thruster
  X = "holonomic" configuration -->
  <arg name="thrust_config" default="T" />
  <!-- Do we load the VRX sensor suite? -->
  <arg name="vrx_sensors_enabled" default="true" />
  <arg name="wamv_urdf" default="$(find wamv_gazebo)/urdf/wamv_gazebo.urdf.xacro"/>
  <arg name="smallboat_urdf" default="$(find wamv_gazebo)/urdf/sb_gazebo.urdf.xacro"/>

  <!-- Start Gazebo with the world file -->
  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="world_name"   value="$(arg world)"/>
    <arg name="verbose"      value="$(arg verbose)"/>
    <arg name="paused"       value="$(arg paused)"/>
    <arg name="use_sim_time" value="true"/>
    <arg name="gui"          value="$(arg gui)" />
    <arg name="extra_gazebo_args" value="$(arg extra_gazebo_args)"/>
  </include>

  <!-- Load robot model -->

  <!-- Spawn the first USV (wamv) -->
  <param name="wamv/robot_description"
          command="$(find xacro)/xacro --inorder '$(arg wamv_urdf)'
          locked:=$(arg wamv_locked)           
          thruster_config:=$(arg thrust_config)
          vrx_sensors_enabled:=$(arg vrx_sensors_enabled)
          namespace:=wamv "/>

  <node name="spawn_model_wamv" pkg="gazebo_ros" type="spawn_model"
        args="-x -25 -y 30 -z 0
              -R 0 -P 0 -Y -2.4
              -urdf -param wamv/robot_description -model wamv"/>
  
  <node pkg="robot_state_publisher" type="robot_state_publisher" name="wamv_tf_pub" >
      <remap from="robot_description" to="wamv/robot_description" />
      <remap from="joint_states" to="wamv/joint_states" />
  </node>

  <include file="$(find localization)/launch/pub_tf_posestamped.launch">
    <arg name="model_name" value="wamv"/>
    <arg name="pub_tf" value="true"/>
    <arg name="pub_pose" value="true"/>
  </include>

  <!-- Launch LiDAR for wamv -->
  <include file="$(find lidar_crop)/launch/lidar_crop.launch">
      <arg name="veh" value="wamv"/>
  </include>
  


  <!-- Spawn the first USV (small boat) -->
  <param name="sb1/robot_description"
          command="$(find xacro)/xacro --inorder '$(arg smallboat_urdf)'
          locked:=$(arg wamv_locked)
          namespace:=sb1 "/>

  <node name="spawn_model_sb1" pkg="gazebo_ros" type="spawn_model"
        args="-x 0 -y 0 -z 0
              -R 0 -P 0 -Y 0
              -urdf -param sb1/robot_description -model sb1"/>
  
  <node pkg="robot_state_publisher" type="robot_state_publisher" name="sb1_tf_pub" >
      <remap from="robot_description" to="sb1/robot_description" />
      <remap from="joint_states" to="sb1/joint_states" />
  </node>

  <include file="$(find localization)/launch/pub_tf.launch">
    <arg name="veh" value="sb1"/>
  </include>

  <!-- Spawn the second USV (wamv2) -->
  <param name="wamv2/robot_description"
          command="$(find xacro)/xacro --inorder '$(arg wamv_urdf)'
          locked:=$(arg wamv_locked)           
          thruster_config:=$(arg thrust_config)
          vrx_sensors_enabled:=$(arg vrx_sensors_enabled)
          namespace:=wamv2 "/>

  <node name="spawn_model_wamv2" pkg="gazebo_ros" type="spawn_model"
        args="-x 30 -y 0 -z 0
              -R 0 -P 0 -Y -1.57
              -urdf -param wamv2/robot_description -model wamv2"/>
  
  <node pkg="robot_state_publisher" type="robot_state_publisher" name="wamv2_tf_pub" >
      <remap from="robot_description" to="wamv2/robot_description" />
      <remap from="joint_states" to="wamv2/joint_states" />
  </node>

  <include file="$(find localization)/launch/pub_tf_posestamped.launch">
    <arg name="model_name" value="wamv2"/>
    <arg name="pub_tf" value="true"/>
    <arg name="pub_pose" value="true"/>
  </include>

  <!-- Launch LiDAR for wamv -->
  <include file="$(find lidar_crop)/launch/lidar_crop.launch">
      <arg name="veh" value="wamv2"/>
  </include>

  <!-- Spawn the third USV (wamv3) -->
  <param name="wamv3/robot_description"
          command="$(find xacro)/xacro --inorder '$(arg wamv_urdf)'
          locked:=$(arg wamv_locked)           
          thruster_config:=$(arg thrust_config)
          vrx_sensors_enabled:=$(arg vrx_sensors_enabled)
          namespace:=wamv3 "/>

  <node name="spawn_model_wamv3" pkg="gazebo_ros" type="spawn_model"
        args="-x -25 -y -30 -z 0
              -R 0 -P 0 -Y -0.8
              -urdf -param wamv3/robot_description -model wamv3"/>
  
  <node pkg="robot_state_publisher" type="robot_state_publisher" name="wamv3_tf_pub" >
      <remap from="robot_description" to="wamv3/robot_description" />
      <remap from="joint_states" to="wamv3/joint_states" />
  </node>

  <include file="$(find localization)/launch/pub_tf_posestamped.launch">
    <arg name="model_name" value="wamv3"/>
    <arg name="pub_tf" value="true"/>
    <arg name="pub_pose" value="true"/>
  </include>

  <!-- Launch LiDAR for wamv -->
  <include file="$(find lidar_crop)/launch/lidar_crop.launch">
      <arg name="veh" value="wamv3"/>
  </include>

  <!-- Spawn the third USV (wamv4) -->
  <param name="wamv4/robot_description"
          command="$(find xacro)/xacro --inorder '$(arg wamv_urdf)'
          locked:=$(arg wamv_locked)           
          thruster_config:=$(arg thrust_config)
          vrx_sensors_enabled:=$(arg vrx_sensors_enabled)
          namespace:=wamv4 "/>

  <node name="spawn_model_wamv4" pkg="gazebo_ros" type="spawn_model"
        args="-x 70 -y 99 -z 0
              -R 0 -P 0 -Y -1.57
              -urdf -param wamv4/robot_description -model wamv4"/>
  
  <node pkg="robot_state_publisher" type="robot_state_publisher" name="wamv4_tf_pub" >
      <remap from="robot_description" to="wamv4/robot_description" />
      <remap from="joint_states" to="wamv4/joint_states" />
  </node>

  <include file="$(find localization)/launch/pub_tf_posestamped.launch">
    <arg name="model_name" value="wamv4"/>
    <arg name="pub_tf" value="true"/>
    <arg name="pub_pose" value="true"/>
  </include>

  <!-- Launch LiDAR for wamv -->
  <include file="$(find lidar_crop)/launch/lidar_crop.launch">
      <arg name="veh" value="wamv4"/>
  </include>

</launch>
