<launch>
    <arg name="veh" default="wamv2"/>
    <arg name="sub_bbox_center_cord_topic" default="/detr_inference_searching/highest_conf_detection_bbox_center_cord"/>
    <arg name="sub_bbox_area_topic" default="/detr_inference_searching/highest_conf_detection_bbox_area"/>
    <arg name="sub_detected_topic" default="/detr_inference_searching/detected"/>
    <!-- <arg name="kp" default="-0.5"/> -->
    <!-- Node to run the visual servoing -->
    <node ns="$(arg veh)" pkg="vrx_gazebo" type="bbox2twist_angular.py" name="bbox2twist_angular" output="screen">
        <param name="sub_bbox_center_cord_topic" value="$(arg sub_bbox_center_cord_topic)"/>
        <param name="sub_bbox_area_topic" value="$(arg sub_bbox_area_topic)"/>
        <param name="sub_detected_topic" value="$(arg sub_detected_topic)"/>
        <!-- <param name="kp" value="$(arg kp)"/> -->
    </node>

</launch>