<?xml version="1.0"?>
<launch>
  <arg name="veh" default="wamv2"/>
  
  <arg name="use_joy" default="true"/>
  <arg name="use_namespace" default="false"/>

  <!-- Conditionally launch the Joy node -->
  <group if="$(arg use_joy)">
    <node pkg="joy" type="joy_node" name="joy">
      <!-- <remap from="/joy" to="/$(arg veh)/joy" if="$(arg use_namespace)"/> -->
      <param name="dev" value="/dev/input/js1"/>
    </node>
  </group>

  <node pkg="vrx_gazebo" type="multi_vr_remap_joy.py" name="multi_vr_remap_joy" output="screen">
    <param name="pub_joy_topic" value="/$(arg veh)/joy"/>
  </node>
  
  <!-- Convert Twist messages to Drive messages -->
  <node ns="$(arg veh)" pkg="vrx_gazebo" type="joy2twist_estop.py" name="joy2twist1" output="screen">
    <!-- <remap from="/joy" to="/$(arg veh)/joy" if="$(arg use_namespace)"/> -->
    <param name="sub_joy_topic" value="/$(arg veh)/joy"/>
    <remap from="left_cmd" to="/$(arg veh)/thrusters/left_thrust_cmd"/>
    <remap from="right_cmd" to="/$(arg veh)/thrusters/right_thrust_cmd"/>
    <remap from="left_lateral_cmd" to="/$(arg veh)/thrusters/left_lateral_thrust_cmd"/>
    <remap from="right_lateral_cmd" to="/$(arg veh)/thrusters/right_lateral_thrust_cmd"/>
  </node>
  
</launch>
